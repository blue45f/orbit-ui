{
  "name": "orbit-ui",
  "private": true,
  "description": "3계층 아키텍처 기반 React 디자인 시스템 컴포넌트 라이브러리",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm exec turbo run build",
    "test": "pnpm exec turbo run test --concurrency=1",
    "test:watch": "pnpm -r test:watch",
    "typecheck": "pnpm exec turbo run typecheck",
    "lint": "eslint packages && pnpm exec turbo run lint",
    "audit:security": "pnpm audit --audit-level high --ignore GHSA-2p57-rm9w-gvfp",
    "lint:security": "pnpm run lint && pnpm run audit:security",
    "lint:fix": "eslint packages --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "verify": "pnpm run validate:architecture && pnpm run ci",
    "verify:push": "pnpm run verify && pnpm run lint:security",
    "gen": "pnpm --filter @orbit-ui/generator gen",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky",
    "validate:architecture": "node scripts/validate-architecture.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@heejun/eslint-config": "^5.0.0",
    "@heejun/prettier-config": "^3.0.0",
    "@types/node": "catalog:",
    "eslint": "^10.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "prettier": "@heejun/prettier-config",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.4.0"
}
